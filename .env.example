# Copy to .env and fill in. Never commit the real file.

# From your Discord application: https://discord.com/developers/applications
# OAuth2 → Client information
CLIENT_ID=
CLIENT_SECRET=
# Bot → Token (Reset Token to see it)
BOT_TOKEN=

# Encrypts the session cookie. Any long random string, e.g. `openssl rand -base64 48`.
# Changing it signs everyone out.
SESSION_SECRET=

# Optional. The public URL of the app, without a trailing slash, if it differs from the
# request origin (for example behind a reverse proxy): https://emotes.example.com
# Used to build the OAuth redirect URL, so `${APP_URL}/api/auth/callback` must be listed
# under OAuth2 → Redirects. Leave it commented out to use the request origin.
# APP_URL=https://emotes.example.com
